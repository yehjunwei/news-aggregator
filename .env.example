# === LLM ===
# provider: gemini | openai（預設 gemini）
LLM_PROVIDER=gemini
LLM_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_SUMMARY_SENTENCES=3
LLM_BATCH_SIZE=8

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Sources ===
# GitHub token（選用，提高 search rate limit 到 30 req/min）
GITHUB_TOKEN=
# 來源清單設定檔（預設 config/sources.json）
# SOURCES_FILE=config/sources.json

# === pipeline / scoring ===
TOP_N=20
# 每類別在每日推送的最多則數（提升多元性，0=不限）
MAX_PER_CATEGORY=4
DEDUP_TITLE_THRESHOLD=88
DEDUP_LOOKBACK_DAYS=7
RECENCY_HALF_LIFE_HOURS=24
VELOCITY_CAP=1.0

# === http ===
HTTP_TIMEOUT=20
HTTP_MAX_RETRIES=3
RATE_LIMIT_PER_HOST=5

# === db ===
# 預設 sqlite:///data/news.db
DATABASE_URL=

# 顯示時區固定 Asia/Taipei
TIMEZONE=Asia/Taipei

# openclaw 金鑰檔（未設環境變數時用此補齊 GEMINI/OPENAI/TELEGRAM/GITHUB 金鑰）
CREDENTIALS_FILE=~/.openclaw/credentials/api_keys.json
